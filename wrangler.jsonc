{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "golivee",
  "compatibility_date": "2026-10-21",
  "main": "./worker/index.js",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true
  }
}
